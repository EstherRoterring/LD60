[sub_resource type="GDScript" id="GDScript_lwufx"]
script/source = "extends Node2D

@onready var monsters_container: Node2D = $Monsters
@onready var monster_spawner = $MonsterSpawner

const START_POSITION := Vector2(75, 45)
const MONSTER_SPACING := 35.0

func _ready() -> void:
	$Track.track_ready.connect(_on_track_ready)

func _on_track_ready() -> void:
	print('track ready')
	spawn_all_monsters(monsters_container)

func spawn_all_monsters(monster_container: Node2D) -> void:
	var track: Track = $Track.track

	if track == null:
		push_warning(\"Track ist noch nicht geladen.\")
		return

	for time in range(track.length):
		var notes = track.getMonstersAndPitchbyTime(time)

		for note in notes:
			var monster_name: String = note[\"monster\"]
			var pitch: int = note[\"pitch\"]

			var monster: MusicMonster = monster_spawner.spawn_music_monster( monster_name, false)
			print(\"Spawn-Ergebnis: \", monster)
			
			if monster == null:
				continue

			monster.reparent(monster_container)

			# Jeder Zeitpunkt bekommt eine eigene Spalte.
			monster.position = START_POSITION - Vector2(time * MONSTER_SPACING, 0)
			print(
				\"Monster: \", monster.name,
				\" | Position: \", monster.position,
				\" | Sichtbar: \", monster.visible
			)
			monster.pitch = pitch
			monster.change_color_to_pitch()
"

